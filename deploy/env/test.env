# SAIL_PORT/SAIL_DB: adaptador legado serve.mjs. PORT/DATABASE_URL: backend nativo (server/main.mjs).
SAIL_PORT=9001
SAIL_DB=sail_test
PORT=9001
DATABASE_URL=postgresql://%2Frun%2Fpostgresql/sail_test
# Login (ADR-0005): links dos e-mails. Segredos (SAIL_POW_SECRET, SMTP_HOST/PORT/USER/PASS/FROM)
# ficam em /opt/sail/test.secrets.env, criado vazio pelo install.sh e preenchido à mão —
# nunca neste arquivo. SAIL_ENV=test liga o login sempre (e-mails no log sem SMTP).
SAIL_BASE_URL=https://sail-test.sailstation.com

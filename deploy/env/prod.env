# SAIL_PORT/SAIL_DB: adaptador legado serve.mjs. PORT/DATABASE_URL: backend nativo (server/main.mjs).
SAIL_PORT=9000
SAIL_DB=sail_prod
PORT=9000
DATABASE_URL=postgresql://%2Frun%2Fpostgresql/sail_prod
# Login (ADR-0005): links dos e-mails. Segredos (SAIL_POW_SECRET, SMTP_HOST/PORT/USER/PASS/FROM)
# ficam em /opt/sail/prod.secrets.env, criado vazio pelo install.sh e preenchido à mão —
# nunca neste arquivo. O login obrigatório liga sozinho quando SMTP_HOST estiver definido lá
# (SAIL_LOGIN_REQUIRED=1/0 força o valor).
SAIL_BASE_URL=https://sail-pro.sailstation.com
